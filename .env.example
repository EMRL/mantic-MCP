# Mautic MCP environment configuration
# Reference values only. The application reads process.env and does not
# automatically load this file. Supply variables through your shell,
# MCP launcher, or a protected service environment file.

# Mautic API and OAuth2 client credentials
MAUTIC_BASE_URL=https://your-mautic-instance.example.com/api/
MAUTIC_TOKEN_ENDPOINT=https://your-mautic-instance.example.com/oauth/v2/token
MAUTIC_CLIENT_ID=your_client_id_here
MAUTIC_CLIENT_SECRET=your_client_secret_here

# MCP tool access mode (optional; default: readonly)
# reporting = 9 tested email and report tools
# readonly  = 31 approved read operations, including reporting tools
# full      = all 67 registered tools, including writes and deletions
# Full mode is intended only for explicitly authorized administration.
# Some read tools return contact or submission data; all upstream tools
# have not been verified against Mautic 4.
MCP_ACCESS_MODE=readonly

# OpenAI Secure MCP Tunnel configuration is separate from the MCP server.
# Supply CONTROL_PLANE_API_KEY to the tunnel client, not this file.
